{
  "name": "co-dev-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for CO-DEV: multi-session context injection, checkpoint management, and role detection",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "clean": "rm -rf dist",
    "sync:plugin-skills": "rm -rf plugin/skills && cp -r src/templates/skills plugin/skills",
    "bundle:plugin": "npm run sync:plugin-skills && node scripts/bundle-plugin.mjs",
    "package": "npm run build && npm run bundle:plugin"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "adm-zip": "^0.5.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
